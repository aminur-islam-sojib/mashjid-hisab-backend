// =============================================================================
// chanda.prisma — Domain G: Monthly Chanda (Recurring plans & dues)
//
// Design notes:
//  • ChandaPlan defines a recurring contribution plan for a Family or a
//    Membership into a specific Fund (e.g. General, Madrasa).
//  • Frequency: MONTHLY or YEARLY.
//  • Invariant: Only one ACTIVE plan per payer per fund.
//  • Dues are periodic liabilities generated by /dues/generate.
//  • Dues are idempotent per (planId, period), where period is "YYYY-MM" (e.g. "2026-07").
//  • Recording a payment on a due creates a Donation linked to the Due via dueId.
//  • Waiving a due marks it WAIVED by an ADMIN with an audit reason.
// =============================================================================

model ChandaPlan {
  id           String           @id @default(cuid())
  mosqueId     String
  mosque       Mosque           @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  // Designated Fund
  fundId       String
  fund         Fund             @relation(fields: [fundId], references: [id], onDelete: Restrict)

  // Monetary value in minor units (poisha), strictly positive BigInt
  amount       BigInt

  // Recurrence frequency
  frequency    ChandaFrequency  @default(MONTHLY)

  // Start period in "YYYY-MM" format (e.g. "2026-07")
  startMonth   String

  // Payer identification: either a Family OR a Membership
  familyId     String?
  family       Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)

  memberId     String?
  member       Membership?      @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // Lifecycle
  status       ChandaPlanStatus @default(ACTIVE)
  pausedAt     DateTime?
  resumedAt    DateTime?
  endedAt      DateTime?

  // Audit trail
  createdById  String?
  createdBy    User?            @relation("ChandaPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  dues         Due[]

  @@index([mosqueId])
  @@index([fundId])
  @@index([familyId])
  @@index([memberId])
  @@index([status])
  @@map("chanda_plans")
}

model Due {
  id           String        @id @default(cuid())
  mosqueId     String
  mosque       Mosque        @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  planId       String
  plan         ChandaPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Redundant linkages for fast filtering and reporting
  fundId       String
  fund         Fund          @relation(fields: [fundId], references: [id], onDelete: Restrict)

  familyId     String?
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)

  memberId     String?
  member       Membership?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // The billing period in "YYYY-MM" format (e.g. "2026-07")
  period       String

  // Due amount in minor units (poisha) snapshot at the time of generation
  amount       BigInt

  // Paid amount accumulated from POSTED donations linked to this due
  paidAmount   BigInt        @default(0)

  // Lifecycle status
  status       DueStatus     @default(UNPAID)

  // Waive audit trail
  waivedAt     DateTime?
  waivedById   String?
  waivedBy     User?         @relation("DueWaiver", fields: [waivedById], references: [id], onDelete: SetNull)
  waiveReason  String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  donations    Donation[]

  // Idempotency guarantee: A plan can only generate one due per period
  @@unique([planId, period])
  @@index([mosqueId])
  @@index([fundId])
  @@index([familyId])
  @@index([memberId])
  @@index([period])
  @@index([status])
  @@map("dues")
}

