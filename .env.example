# =============================================================================
# Mashjid Hisab Backend — Environment Template (.env.example)
# =============================================================================

# Server & Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration (REQUIRED) 
DATABASE_URL="postgresql://postgres:password@localhost:5432/mashjid_hisab?schema=public" 

# JWT & Security Secrets (REQUIRED)
JWT_ACCESS_SECRET="generate-with-crypto-randomBytes-32-hex"
JWT_REFRESH_SECRET="generate-with-crypto-randomBytes-32-hex"
JWT_SECRET="generate-with-crypto-randomBytes-32-hex"

# JWT Expiration & Lifetimes
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ACCESS_EXPIRES_IN_MS=900000
JWT_REFRESH_EXPIRES_IN_MS=604800000

# Password Hashing
BCRYPT_ROUNDS=12

# Token Lifetimes (in milliseconds)
EMAIL_VERIFY_TOKEN_TTL_MS=86400000
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# Email / SMTP Settings (Optional in dev, required in production)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@mashjid-hisab.com"

